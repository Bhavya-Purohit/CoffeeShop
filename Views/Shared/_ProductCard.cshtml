@model IEnumerable<Product>

<section class="content4 cid-products-list" id="products-list">
    <div class="container">
        <div class="row mt-4">
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="item-wrapper">
                            <div class="item-img">
                                <img src="@item.ImageUrl" alt="@item.Name" class="card-img-top" />
                            </div>
                            <div class="card-body text-center">
                                <h5 class="card-title">@item.Name</h5>
                                <p class="card-text">@item.Detail</p>
                                <p class="card-text fw-bold">₹@item.Price.ToString("c")</p>
                                <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-primary">View Details</a>
                            </div>
                            <div class="mbr-section-btn item-footer mt-2">
                                <a asp-controller="ShoppingCart" asp-action="AddToShoppingCart" asp-route-pId="@item.Id" class="btn item-btn btn-primary display-4" target="_self">
                                    <span class="mbrib-cart-add mbr-iconfont mbr-iconfont-btn"></span>Add to cart
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
