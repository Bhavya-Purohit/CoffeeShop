<!---
@{
    ViewData["Title"] = "Delete Order";
}

<h2>Order Details</h2>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.FirstName @Model.LastName</dd>

    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@Model.Phone</dd>

    <dt class="col-sm-2">Address</dt>
    <dd class="col-sm-10">@Model.Address</dd>
</dl>

<hr />

<h4>Order Items</h4>
@if (Model.OrderDetails == null || !Model.OrderDetails.Any())
{
    <p>No items found for this order.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Product</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Subtotal</th>
                <th>Order Date</th>
                <th>Order Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>@Model.Id</td>
                    <td>@item.Product.Name</td>
                    <td>@item.Quantity</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>Rs @(item.Quantity * item.Price)</td>
                    <td>@Model.OrderPlaced.ToString("dd/MM/yyyy")</td>
                    <td>@Model.OrderPlaced.ToString("hh:mm tt")</td>
                </tr>
            }
        </tbody>
    </table>
}-->

