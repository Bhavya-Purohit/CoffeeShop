@model CoffeeShop.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<br />
<h2 style="margin-left: 20px;">Delete Product</h2>
<br />
<div>
    <h4 style="margin-left: 20px;">Are you sure you want to delete this product?</h4>
    <hr />
    <dl class="row" style="margin-left: 20px;">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Price.ToString("c")</dd>

        <dt class="col-sm-2">Detail</dt>
        <dd class="col-sm-10">@Model.Detail</dd>

        <dt class="col-sm-2">Image URL</dt>
        <dd class="col-sm-10">@Model.ImageUrl</dd>
    </dl>
</div>

<form asp-action="DeleteProduct" method="post">
    
    <input type="hidden" asp-for="Id" />

    <div class="d-flex" style="margin-left: 20px;">
    <button type="submit" class="btn btn-danger me-2">Delete</button>
  
    <a asp-action="ManageProducts" class="btn btn-secondary" style="width: 100px;">Cancel</a>
    </div>
</form>