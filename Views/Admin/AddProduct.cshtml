@model CoffeeShop.Models.Product

@{
    ViewData["Title"] = "Add New Product";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Add New Product</h2>

    <!-- Add a card to make the form more organized -->
    <div class="card shadow-lg">
        <div class="card-body">
            <!-- Product form starts here -->
            <form asp-action="AddProduct" method="post" enctype="multipart/form-data">
                <div class="row mb-3">
                    <!-- Name input -->
                    <div class="col-md-6">
                        <label for="Name" class="form-label">Product Name</label>
                        <input type="text" asp-for="Name" class="form-control" placeholder="Enter product name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- Price input -->
                    <div class="col-md-6">
                        <label for="Price" class="form-label">Price</label>
                        <input type="number" asp-for="Price" class="form-control" placeholder="Enter price" step="20" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <!-- Image input -->
                    <div class="col-md-6">
                        <label for="ImageUrl" class="form-label">Image URL</label>
                        
                        <input type="url" asp-for="ImageUrl" class="form-control" placeholder="Enter image URL" />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>

                    <!-- Trending product checkbox -->
                    <div class="col-md-6">
                        <label for="IsTrendingProduct" class="form-label">Trending Product?</label>
                        <div class="form-check">
                            <input type="checkbox" asp-for="IsTrendingProduct" class="form-check-input" />
                            <label class="form-check-label" for="IsTrendingProduct">Yes</label>
                        </div>
                    </div>
                </div>

                <!-- Product description -->
                <div class="mb-3">
                    <label for="Detail" class="form-label">Product Detail</label>
                  
                    <textarea asp-for="Detail" class="form-control" rows="4" placeholder="Enter product description"></textarea>
                    <span asp-validation-for="Detail" class="text-danger"></span>
                </div>

                <!-- Submit and Cancel buttons -->
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary me-2">Add Product</button>
                    <a asp-action="ManageProducts" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Include validation script -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

