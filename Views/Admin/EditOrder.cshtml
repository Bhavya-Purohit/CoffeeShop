@model CoffeeShop.Models.Order

<h2>Edit Order</h2>

<form asp-action="EditOrder" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="OrderStatus">Order Status</label> <!-- Input for OrderStatus -->
        <input asp-for="OrderStatus" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="TrackingNumber">Tracking Number</label> <!-- Input for TrackingNumber -->
        <input asp-for="TrackingNumber" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="OrderTotal"></label>
        <input asp-for="OrderTotal" class="form-control" readonly />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="ManageOrders" class="btn btn-secondary">Cancel</a>
</form>
