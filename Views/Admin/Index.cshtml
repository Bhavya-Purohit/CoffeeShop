@{
    ViewBag.Title = "Admin Dashboard";
}

<section data-bs-version="5.1" class="header18 cid-tsEQyIZRcx mbr-fullscreen mbr-parallax-background" id="header18-1">
    <div class="mbr-overlay" style="opacity:0.9; background-image: url('https://images.unsplash.com/photo-1580933073521-dc49ac0d4e6a?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=2000&q=80');"></div>
    <div class="mbr-overlay" style="opacity: 0.7; background-color: rgb(0, 0, 0);"></div>
    <div class="align-center container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10">
                <h1 class="mbr-section-title mbr-fonts-style mbr-white mb-3 display-5"><strong>The daily grind coffee house</strong></h1>

                <p class="mbr-text mbr-fonts-style mbr-white display-2">
                    Welcome Admin!
                </p>
                <br />
               


                <div class="row mb-4">
                    <!-- Total Users Card -->
                    <div class="col-md-3">
                        <div class="card text-black mb-2 h-60" style="background-color: #fffdd0;">
                            <div class="card-header">Total Users</div>
                            <div class="card-body">
                                <h5 class="card-title">@Model.TotalUsers</h5>
                            </div>
                        </div>
                    </div>

                    <!-- Total Orders Card -->
                    <div class="col-md-3">
                        <div class="card text-black mb-2 h-60" style="background-color: #fffdd0;">
                            <div class="card-header">Total Orders</div>
                            <div class="card-body">
                                <h5 class="card-title">@Model.TotalOrders</h5>
                            </div>
                        </div>
                    </div>

                    <!-- Total Revenue Card -->
                    <div class="col-md-3">
                        <div class="card text-black mb-2 h-60" style="background-color: #fffdd0;">
                            <div class="card-header">Total Revenue</div>
                            <div class="card-body">
                                <h5 class="card-title">@Model.TotalRevenue.ToString("C")</h5>
                            </div>
                        </div>
                    </div>

                    <!-- New Orders Card -->
                    <div class="col-md-3">
                        <div class="card text-black mb-2 h-60" style="background-color: #fffdd0;">
                            <div class="card-header">New Orders</div>
                            <div class="card-body">
                                <h5 class="card-title">@Model.NewOrders</h5>
                            </div>
                        </div>
                    </div>
                </div>

                <br />


         
                <div class="row mb-4" style="padding: 10px;">
                    <!-- Added padding to the row for space -->
                    <!-- Sales Line Chart -->
                    <div class="col-md-6">
                        <canvas id="salesChart" style="width:100%; height:200px; background-color: white; padding:2px;"></canvas> <!-- Solid white background -->
                    </div>

                    <!-- Growth Rate Bar Chart -->
                    <div class="col-md-6">
                        <canvas id="CalculateGrowthRate" style="width:100%; height:200px; background-color: white; padding:2px;"></canvas> <!-- Solid white background -->
                    </div>
                </div>
</section>
                @section Scripts {
                    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                    <script>
                        // Sales Line Chart
                        var ctx1 = document.getElementById('salesChart').getContext('2d');
                        var salesChart = new Chart(ctx1, {
                            type: 'line',
                            data: {
                                labels: ['January', 'February', 'March', 'April', 'May', 'June'],
                                datasets: [{
                                    label: 'Sales',
                                    data: [100, 200, 150, 300, 400, 320],
                                    backgroundColor: 'rgba(54, 162, 235, 0.2)',
                                    borderColor: 'rgba(54, 162, 235, 1)',
                                    borderWidth: 2
                                }]
                            },
                            options: {
                                responsive: true,
                                plugins: {
                                    legend: {
                                        display: true
                                    }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: true
                                    }
                                },
                                elements: {
                                    line: {
                                        tension: 0.3
                                    }
                                },
                                layout: {
                                    padding: {
                                        left: 10,
                                        right: 10,
                                        top: 10,
                                        bottom: 10
                                    }
                                }
                            }
                        });

                        // Growth Rate Bar Chart
                        var ctx2 = document.getElementById('CalculateGrowthRate').getContext('2d');
                        var growthRateChart = new Chart(ctx2, {
                            type: 'bar',
                            data: {
                                labels: ['January', 'February', 'March', 'April', 'May', 'June'],
                                datasets: [{
                                    label: 'Growth Rate',
                                    data: [0.1, 0.15, 0.2, 0.25, 0.3, 0.35],
                                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                                    borderColor: 'rgba(255, 99, 132, 1)',
                                    borderWidth: 1
                                }]
                            },
                            options: {
                                responsive: true,
                                plugins: {
                                    legend: {
                                        display: true
                                    }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        ticks: {
                                            callback: function (value) {
                                                return value * 100 + '%'; // Format y-axis as percentage
                                            }
                                        }
                                    }
                                }
                            }
                        });
                    </script>
                }

