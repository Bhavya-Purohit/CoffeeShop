@model CoffeeShop.Models.Order

@{
    ViewData["Title"] = "Order Details";
}




    <br />
    <h2 style="margin-left: 20px;">Order Details</h2>
    <br />

<dl class="row" style="margin-left: 20px;">
        
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.FirstName @Model.LastName</dd>

        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.Phone</dd>

        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Model.Address</dd>

    <dt class="col-sm-2">Order Status</dt>
    <dd class="col-sm-10">@Model.OrderStatus</dd>

    <dt class="col-sm-2">Tracking Number</dt>
    <dd class="col-sm-10">@Model.TrackingNumber</dd>

    </dl>


<hr />

<div style="margin-left: 20px;">
    <h4>Order Items</h4>
    @if (Model.OrderDetails == null || !Model.OrderDetails.Any())
    {
        <p>No items found for this order.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Subtotal</th>
                    <th>Order Date</th>
                    <th>Order Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    <tr>
                        <td>@Model.Id</td>
                        <td>@item.Product.Name</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price.ToString("C")</td>
                        <td>Rs @(item.Quantity * item.Price)</td>
                        <td>@Model.OrderPlaced.ToString("dd/MM/yyyy")</td>
                        <td>@Model.OrderPlaced.ToString("hh:mm tt")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="mt-3">
    <a asp-action="ManageOrders" class="btn btn-primary">Back to Orders</a>
</div>
