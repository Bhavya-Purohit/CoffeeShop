@model List<CoffeeShop.Models.Product>

@{
    ViewData["Title"] = "Manage Products";
}



@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}



<div class="container mt-5">
    <div class="text-center mb-4">
        <h1 class="display-5 font-weight-bold text-uppercase bg-primary text-white p-1 rounded shadow">Manage Products</h1>
    </div>
    

    
   
        <table class="table table-bordered table-striped">
            <thead class="thead-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Image</th>
                    <th>Detail</th>
                    <th style="width: 75px;">Price</th>
                    <th>Is Trending</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>@product.Name</td>
                        <td>
                            <img src="@product.ImageUrl" alt="@product.Name" style="width: 50px; height: auto;" />
                        </td>
                        <td>
                        <span class="short-desc">@product.Detail.Substring(0, Math.Min(50, product.Detail.Length))</span>
                        <span class="full-desc" style="display: none;">@product.Detail</span>
                        @if (product.Detail.Length > 100)
                        {
                            <a href="javascript:void(0);" class="toggle-desc">...more</a>
                        }
                        </td>
                        <td>@product.Price.ToString("C")</td>
                        <td>@(product.IsTrendingProduct ? "Yes" : "No")</td>
                        <td>

                        <div class="btn-group" style="display: flex; gap: 10px; ">
                            <a href="@Url.Action("EditProduct", "Admin", new { id = product.Id })" title="Edit">
                                <img src="https://www.svgrepo.com/show/73131/edit-button.svg" alt="Edit" style="width: 20px; height: 20px;" />
                            </a>

                            <a href="@Url.Action("DeleteProduct", "Admin", new { id = product.Id })" title="Delete" onclick="return confirm('Are you sure you want to delete this order?');">
                                <img src="https://th.bing.com/th/id/OIP.n3ahyM7JKnUecto2vf55yQAAAA?rs=1&pid=ImgDetMain" alt="Delete" style="width: 20px; height: 20px;" />
                            </a>
                        </div>

                        </td>
                    </tr>
                }
            </tbody>
        </table>

    <div class="table-responsive">
        <div class="text-right">
            <a class="btn btn-primary" href="@Url.Action("AddProduct", "Admin")">+</a>
            <a href="/Admin" class="btn btn-primary">Back</a>
        </div>
    </div>
    </div>

@section Scripts {
    <script>
        // Toggle more/less functionality
        document.querySelectorAll('.toggle-desc').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var shortDesc = this.previousElementSibling.previousElementSibling;
                var fullDesc = this.previousElementSibling;

                if (fullDesc.style.display === 'none') {
                    fullDesc.style.display = 'inline';
                    shortDesc.style.display = 'none';
                    this.textContent = ' show less';
                } else {
                    fullDesc.style.display = 'none';
                    shortDesc.style.display = 'inline';
                    this.textContent = '... more';
                }
            });
        });
    </script>
}
   
<style>
    .edit-button, .delete-button {
        width: 50px; /* Adjust this value as needed */
        padding: 5px 10px; /* Adjust padding for button height */
        font-size: 14px; /* Adjust font size */
        text-align: center;
    }

    .edit-button {
        background-color: sandybrown; /* Edit button color */
        color: white;
        border: none;
    }

    .delete-button {
        background-color: sandybrown; /* Delete button color */
        color: white;
        border: none;
    }

</style>