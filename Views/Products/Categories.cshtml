@model IEnumerable<CoffeeShop.Models.Category>


    
@{
    ViewData["Title"] = "Browse Categories";
}

<h2>Browse Categories</h2>

<ul class="list-group">
    @foreach (var category in Model)
    {
        <li class="list-group-item">
            <a asp-action="ProductsByCategory" asp-route-id="@category.Id">@category.Name</a>
        </li>
    }
</ul>

